# Copy to .env. Groq is used by a later milestone; local Qdrant needs no credentials.
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Arista-PlayAI
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# LiveKit Cloud project credentials for browser WebRTC and voice-agent dispatch.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_AGENT_NAME=echodesk-agent
ECHODESK_API_URL=http://localhost:8000
# Set both QDRANT_URL and a real QDRANT_API_KEY to use Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=replace-me